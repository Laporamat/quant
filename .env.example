# ── App ──────────────────────────────────────
APP_NAME=Quant Backend
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
SECRET_KEY=change-me-to-a-long-random-string

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=2
RELOAD=false

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://quant:quant@localhost:5432/quantdb
DATABASE_URL_SYNC=postgresql+psycopg2://quant:quant@localhost:5432/quantdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_PRICE_TTL=86400

# ── Data ──────────────────────────────────────
DATA_FORMAT=parquet
HISTORY_YEARS=20
START_DATE=2004-01-01

# ── Backtesting ───────────────────────────────
DEFAULT_INITIAL_CAPITAL=1000000
DEFAULT_COMMISSION_PCT=0.0015
DEFAULT_SLIPPAGE_PCT=0.0005
MAX_POSITION_SIZE_PCT=0.10
DEFAULT_RISK_FREE_RATE=0.02

# ── Scheduler ────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Bangkok
DATA_REFRESH_CRON=0 18 * * 1-5
